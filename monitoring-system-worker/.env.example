# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=monitoring_system

# Monitoring Services URLs
# Fonte das contagens de erro/warning nos logs.
# Se LOKI_ENABLED=true, o worker consulta o Loki (URL abaixo). Caso contrário, cai no fallback
# CONTAINER_LOGS_* abaixo, que lê o stdout do container via `docker logs` na mesma sessão SSH
# já usada para docker ps/stats -- sem depender de Loki nem de coletor de logs externo.
# Atenção: o Loki do parque fica em 10.10.10.224:3100 (NAO em .223, que era o valor antigo e errado).
LOKI_ENABLED=false
LOKI_URL=http://10.10.10.224:3100

# --- Fallback: leitura direta do stdout dos containers (usado quando LOKI_ENABLED != true) ---
# Requer DOCKER_SSH_HOST/DOCKER_SSH_USERNAME configurados.
CONTAINER_LOGS_ENABLED=true
# Teto de linhas lidas por container por ciclo (protege contra log gigante no SSH)
CONTAINER_LOGS_MAX_LINES=5000
# Teto da janela de leitura em minutos. NAO herda MONITORING_INTERVAL_MINUTES (que em prod
# esta em 240 enquanto o cron roda a cada minuto -- daria 4h de log por container por minuto).
CONTAINER_LOGS_WINDOW_MINUTES=15
# Tamanho da amostra do último erro anexada ao alerta do Discord
CONTAINER_LOGS_LAST_ERROR_CHARS=400
# Padroes de deteccao (regex estendida, case-insensitive). Deixe vazio para usar o default do codigo.
# LOG_ERROR_PATTERN=
# LOG_WARNING_PATTERN=
PROMETHEUS_URL=http://localhost:9090
# Para cada serviço: preencha loki_label na tabela monitoring.services com o job do Loki (ex: gs1-integration-worker)

# Docker via SSH (igual ao Putty!)
DOCKER_SSH_HOST=
DOCKER_SSH_PORT=
DOCKER_SSH_USERNAME=
DOCKER_SSH_PASSWORD=
# Opcional: fingerprint SHA-256 esperado da chave do host, para o worker recusar
# conectar num host que se passe pelo DOCKER_SSH_HOST (que capturaria a senha
# acima). Obtenha com:
#   ssh-keyscan -t rsa <host> | ssh-keygen -lf -
# Vazio = comportamento atual, sem verificacao.
# DOCKER_SSH_HOST_FINGERPRINT=SHA256:...

# Log level: silent | error | warn | info | debug. No servidor use error. Use warn para ver fluxo de alertas (Alert Checking/Creating/Sending)
LOG_LEVEL=error

# Cron Schedule (default: every minute)
CRON_EXPRESSION=*/1 * * * *

# Janela de tempo das queries Loki (minutos). Ex: 15 = 15min, 60 = 1h (para pegar mais logs em teste)
MONITORING_INTERVAL_MINUTES=15

# Discord Webhook for Alerts (obrigatório para receber alertas no Discord; em Docker/prod defina via env ou .env montado)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Disco: alerta Discord quando uso no host SSH (DOCKER_SSH_HOST) passar deste percentual (default 80)
DISK_THRESHOLD_PERCENT=80

# Dashboard URL (for log links in notifications)
DASHBOARD_URL=http://localhost:3000

# --- Destino dos alertas ---
# Discord e Google Chat tem formatos de payload DIFERENTES. O provider e detectado
# pela URL (chat.googleapis.com => Google Chat), entao basta trocar a URL aqui.
# ALERT_WEBHOOK_URL tem precedencia; DISCORD_WEBHOOK_URL segue valendo por compatibilidade.
ALERT_WEBHOOK_URL=
# Force o formato se a URL nao for reconhecivel: discord | googlechat
# ALERT_WEBHOOK_KIND=
# Nao reenviar o mesmo alerta (servico+tipo) antes deste intervalo, em minutos.
ALERT_RESEND_COOLDOWN_MINUTES=30

# =====================================================================
# Monitoramento preditivo de VMs
# =====================================================================
# Desligado por padrao: subir esta versao sem mexer aqui nao muda nada
# no comportamento atual do worker.
VM_MONITORING_ENABLED=false

# Ciclo de checagem das VMs (independente do CRON_EXPRESSION dos servicos).
VM_CRON_EXPRESSION=*/2 * * * *

# Como o worker descobre o estado das VMs:
#   auto         sonda o host DOCKER_SSH_HOST atras de qm/virsh/govc e escolhe sozinho
#   proxmox-ssh  `qm list` + `pct list` via SSH
#   libvirt-ssh  `virsh list --all` via SSH
#   proxmox-api  API HTTP do Proxmox (nao precisa de SSH) -- exige PROXMOX_API_* abaixo
#   govc-ssh     `govc vm.info` via SSH (VMware)
#   none         sem hypervisor: so ping/TCP + heartbeat
# Rode `npm run discover:vms` para ver o que a sondagem encontra no seu ambiente.
VM_PROVIDER=auto

# Proxmox via API (opcional). Quando preenchido, tem precedencia sobre a sondagem SSH:
# a API enxerga o cluster inteiro, e nao so o no em que o SSH cai.
# Crie um token com perfil PVEAuditor -- o worker so le.
PROXMOX_API_URL=
PROXMOX_API_TOKEN_ID=
PROXMOX_API_TOKEN_SECRET=
# Default seguro: valida o certificado. Se o Proxmox usa certificado autoassinado,
# ponha false conscientemente -- sem validacao, um intermediario captura o token da
# API e pode devolver estado de VM falso. Preferir importar a CA do Proxmox.
PROXMOX_API_REJECT_UNAUTHORIZED=true

# --- Fallback de alcancabilidade (quando o hypervisor nao sabe dizer) ---
# Portas testadas por TCP no IP cadastrado da VM. TCP em vez de ICMP porque o
# container nao tem CAP_NET_RAW, e porta aberta e sinal mais forte que ping.
VM_PROBE_PORTS=22,3389
VM_PROBE_TIMEOUT_MS=3000
# Alem do TCP, tenta `ping` a partir do host DOCKER_SSH_HOST -- a sonda sai de
# dentro da rede de gerencia e enxerga VM que o container nao alcanca.
VM_PING_VIA_SSH=true
# Falhas consecutivas antes de alertar "VM inacessivel" (o contador vive no banco).
VM_UNREACHABLE_FAILURES=3

# --- Endpoint de heartbeat (agente dentro das VMs) ---
HEARTBEAT_PORT=5080
HEARTBEAT_BIND=0.0.0.0
# OBRIGATORIO: sem token o endpoint NAO sobe (endpoint de escrita aberto seria
# pior que nao ter o recurso). Use o mesmo valor no MONITOR_TOKEN dos agentes.
MONITOR_HEARTBEAT_TOKEN=
# Silencio acima disso vira alerta no_heartbeat.
HEARTBEAT_MAX_AGE_MINUTES=15
HEARTBEAT_MAX_BODY_BYTES=65536

# --- Disco: thresholds e projecao ---
# Amarelo: uso > 80% OU projecao de encher em < 7 dias
# Vermelho: uso > 90% OU projecao de encher em < 48h
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
DISK_TREND_WINDOW_DAYS=7
DISK_FORECAST_WARNING_DAYS=7
DISK_FORECAST_CRITICAL_HOURS=48
# Minimo de amostras na janela para ajustar a reta (abaixo disso, so o % absoluto vale).
DISK_MIN_SAMPLES_FOR_TREND=3

# --- Anti-spam dos alertas de VM ---
# Nao repete o mesmo alerta da mesma VM antes deste intervalo. Medido no banco
# (vm_alerts.notified_at), entao sobrevive a restart/deploy do container.
VM_ALERT_COOLDOWN_MINUTES=30
