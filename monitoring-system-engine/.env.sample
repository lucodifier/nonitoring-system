# =====================================================================
# monitoring-system-engine (API NestJS) — copie para .env e preencha
#   cp .env.sample .env
# Em producao o .env e gerado pelo pipeline a partir do cofre de segredos.
# =====================================================================

# --- Aplicacao -------------------------------------------------------
NODE_ENV=development
# Porta DENTRO do processo/container. No docker-compose o mapeamento e "5070:3003",
# entao em container use PORT=3003. Rodando local (pnpm start:dev) pode ser 3000/5070.
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
# Opcional: so aparece no banner de boot (URL publica da API)
API_URL=

# --- Banco (PostgreSQL, schema "monitoring") -------------------------
# O MESMO banco e usado pelo monitoring-system-worker.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=monitoring_system
# Mantenha false: o schema e mantido por SQL/migrations, nao por synchronize.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# --- Autenticacao JWT ------------------------------------------------
# Gere um valor forte: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=24h

# --- Loki (consulta de logs na tela Logs do dashboard) ---------------
LOKI_URL=http://localhost:3100
# Alias aceito: LOKI_BASE_URL
# Nomes dos labels no Loki e ambiente usado nos filtros
LOKI_LABEL_CONTAINER=container
LOKI_LABEL_ENV=env
MONITORING_ENV=

# --- Docker no host monitorado (tela Deployment / controle de containers)
# Opcao 1: SSH (tem precedencia quando HOST + USERNAME estao preenchidos)
DOCKER_SSH_HOST=
DOCKER_SSH_PORT=22
DOCKER_SSH_USERNAME=
DOCKER_SSH_PASSWORD=
# Alternativa a senha: chave privada (conteudo PEM)
DOCKER_SSH_PRIVATE_KEY=
# Opcao 2: socket local
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- VMs: limiares usados pelo endpoint /vms (devem espelhar os do worker)
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
DISK_TREND_WINDOW_DAYS=7
DISK_FORECAST_WARNING_DAYS=7
DISK_FORECAST_CRITICAL_HOURS=48
DISK_MIN_SAMPLES_FOR_TREND=3
HEARTBEAT_MAX_AGE_MINUTES=15
